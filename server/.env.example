# Copy to server/.env

# true = fake pipeline (no models). false = the real ML layer in ../ml/pipeline (models: cd ../ml && python -m pipeline.models)
MOCK_AI=true
# Where the ML models live (~2.7 GB). Default: ml/.cache. Keep it out of OneDrive/Dropbox.
# LANTERN_CACHE_DIR=C:/Users/<you>/lantern-ml/cache

# Public HTTPS URL of this server (ngrok/Railway/Render). Twilio downloads read-back audio from here.
PUBLIC_BASE_URL=http://localhost:8000
# Origins of the tourist app.
CORS_ORIGINS=http://localhost:5173,https://sreya-14.github.io

# Twilio WhatsApp Sandbox. Leave empty to use only the /host web page.
# Webhook to set in Twilio: <PUBLIC_BASE_URL>/twilio/whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional: send with an API key instead of the Auth Token (the Auth Token is still needed to verify webhooks).
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Telegram bot for hosts (free; create it with @BotFather). Uses polling, so no public URL is needed.
TELEGRAM_BOT_TOKEN=

# Storage: SQLite by default. For Supabase, its Postgres connection string:
# DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
