    "preview": "vite preview --host",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "chrono-node": "^2.7.0",
    "dexie": "^4.0.0",
    "dexie-react-hooks": "^1.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0"
  }
}
