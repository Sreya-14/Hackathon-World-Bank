{
  "name": "noor-assistant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:real": "vite --mode real",
    "build": "tsc -b && vite build",
